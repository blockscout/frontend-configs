{
  "name": "blockscout_frontend-configs",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.37.0",
    "eslint-plugin-jsonc": "^2.7.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0",
    "prettier": "2.8.7",
    "svgo": "^3.0.2",
    "typescript": "^5.0.3"
  },
  "scripts": {
    "prepare": "husky install",
    "lint:eslint": "eslint .",
    "format-svg": "svgo -r ./configs",
    "generate:footer-links": "node ./tools/footer-links-generator/index.js"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix",
    "*.{js,ts,json,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.4.1"
}
